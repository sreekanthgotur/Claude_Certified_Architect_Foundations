# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_TIER1=claude-sonnet-5-5
ANTHROPIC_MODEL_TIER2=claude-opus-5-5
ANTHROPIC_MODEL_TIER3=claude-opus-5-5
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-5-5

# AWS
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=ccar-f-mvp-api
DYNAMODB_SESSION_TABLE=ccar-sessions
S3_DOCUMENTS_BUCKET=ccar-documents
S3_UPLOADS_BUCKET=ccar-uploads

# MCP server URLs
MCP_CRM_URL=https://mcp.internal/crm
MCP_ORDERS_URL=https://mcp.internal/orders
MCP_KNOWLEDGE_URL=https://mcp.internal/knowledge
MCP_BILLING_URL=https://mcp.internal/billing

# Application
CORS_ORIGINS=http://localhost:5173,https://support.example.com
LOG_LEVEL=INFO
ENVIRONMENT=dev
REFUND_APPROVAL_THRESHOLD=100.00
MAX_ACCOUNT_MODIFICATIONS_PER_SESSION=3
DEDUP_SIMILARITY_THRESHOLD=0.85
